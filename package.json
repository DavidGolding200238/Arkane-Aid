{
  "name": "arkane-aid",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start --go",
    "start:dev": "expo start --dev-client",
    "android": "expo start --go --android",
    "typecheck": "tsc --noEmit",
    "test:functions": "cd supabase/functions && deno check **/*.ts && deno lint && deno test --allow-read",
    "lint": "expo lint",
    "seed:srd": "deno run -A --node-modules-dir=none --no-lock scripts/srd-embed.ts",
    "eval:search": "deno run -A --node-modules-dir=none --no-lock evals/search.ts",
    "eval:answers": "deno run -A --node-modules-dir=none --no-lock evals/answers.ts"
  },
  "dependencies": {
    "@expo-google-fonts/asul": "^0.4.1",
    "@expo-google-fonts/atkinson-hyperlegible": "^0.4.1",
    "@expo-google-fonts/cinzel-decorative": "^0.4.1",
    "@expo-google-fonts/medievalsharp": "^0.4.1",
    "@react-three/fiber": "^9.8.2",
    "@supabase/supabase-js": "^2.57.4",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-dev-client": "~58.0.15",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.9",
    "expo-gl": "~58.0.3",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-speech": "~58.0.3",
    "expo-speech-recognition": "~58.0.0",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "three": "^0.186.1",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.3.0",
    "@types/three": "^0.186.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~6.0.3"
  }
}
