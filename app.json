{
  "expo": {
    "name": "Arkane Aid",
    "slug": "arkane-aid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#E8D7B8",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon/adaptive-foreground.png",
        "backgroundImage": "./assets/images/app-icon/adaptive-background.png",
        "backgroundColor": "#E8D7B8"
      },
      "package": "za.co.openwindow.arkaneaid",
      "permissions": [
        "android.permission.HIGH_SAMPLING_RATE_SENSORS"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "plugins": [
      "expo-dev-client",
      "expo-asset",
      "expo-font",
      "expo-sqlite",
      "expo-image",
      "expo-status-bar",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Arkane Aid uses the microphone while you hold the Sage orb, so you can speak your question or note instead of typing it.",
          "speechRecognitionPermission": "Arkane Aid turns what you say into text while you hold the Sage orb."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Arkane Aid uses motion so you can shake your phone to roll dice."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class expo.modules.gl.** { *; }\n-keep class expo.modules.sensors.** { *; }"
          }
        }
      ]
    ],
    "scheme": "arkaneaid",
    "ios": {
      "bundleIdentifier": "za.co.openwindow.arkaneaid"
    },
    "extra": {
      "eas": {
        "projectId": "4e0800b5-e2f3-4740-883b-0e033cb7ab6e"
      }
    },
    "owner": "brohammer",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4e0800b5-e2f3-4740-883b-0e033cb7ab6e"
    }
  }
}
