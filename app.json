{
  "expo": {
    "name": "Arkane Aid",
    "slug": "arkane-aid",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "androidNavigationBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content"
    },
    "android": {
      "package": "za.co.openwindow.arkaneaid",
      "navigationBarColor": "#000000",
      "permissions": ["RECORD_AUDIO"]
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Arkane Aid to hear your questions and notes.",
          "speechRecognitionPermission": "Allow Arkane Aid to turn your speech into text."
        }
      ]
    ]
  }
}
